<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <!-- 1. Fullscreen Video Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- 2. Loading Indicator -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/tv_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Left Sidebar: Categories + Channels (TiviMate Classic Drawer) -->
    <LinearLayout
        android:id="@+id/leftSidebar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_osd_translucent"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Group List -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分组"
                android:textColor="@color/tv_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groupRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:background="#33FFFFFF" />

        <!-- Channel List -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="频道列表"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Right Catch-up / EPG Panel (7天回看时移) -->
    <LinearLayout
        android:id="@+id/rightEpgPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_osd_translucent"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/epgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7天时移回看"
            android:textColor="@color/tv_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/epgSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择历史节目即可跳转回看"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp"
            android:paddingBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epgRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- 5. Bottom OSD Banner -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:background="@drawable/bg_osd_translucent"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/osdLogo"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/osdChannelNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="01"
            android:textColor="@color/tv_accent"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/osdProgram"
            app:layout_constraintStart_toEndOf="@+id/osdLogo"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/osdChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="CCTV-1 综合"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/osdChannelNum"
            app:layout_constraintStart_toEndOf="@+id/osdChannelNum" />

        <TextView
            android:id="@+id/osdBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/selector_tv_item"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="4K HDR"
            android:textColor="@color/tv_accent"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/osdChannelName"
            app:layout_constraintStart_toEndOf="@+id/osdChannelName"
            app:layout_constraintTop_toTopOf="@+id/osdChannelName" />

        <TextView
            android:id="@+id/osdProgram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="正在播出：新闻联播"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/osdResolution"
            app:layout_constraintStart_toStartOf="@+id/osdChannelNum"
            app:layout_constraintTop_toBottomOf="@+id/osdChannelNum" />

        <TextView
            android:id="@+id/osdResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[OK] 换台  [←] 分组  [→] 7天回看  [菜单] 扫码配源"
            android:textColor="@color/tv_text_dim"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 6. Web Config / QR Code Modal Dialog -->
    <androidx.cardview.widget.CardView
        android:id="@+id/webConfigDialog"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="gone"
        app:cardBackgroundColor="@color/tv_bg_translucent"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="扫码 / 局域网配源服务"
                android:textColor="@color/tv_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="同一 Wi-Fi 下，用手机或电脑浏览器直接访问下方地址："
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <!-- QR Code Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginVertical="10dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/qrCodeImageView"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <TextView
                android:id="@+id/webServerUrlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/selector_tv_item"
                android:padding="10dp"
                android:text="http://192.168.1.100:8888"
                android:textAlignment="center"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="在手机网页上粘贴 M3U 订阅或上传文件，点击推送即可！按 [返回键] 关闭本窗口。"
                android:textColor="@color/tv_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
