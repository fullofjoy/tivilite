<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/tv_bg_dark">

    <!-- 1. Fullscreen Video Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- 2. Loading Indicator -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/tv_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Left Sidebar: Categories + Channels (TiviMate Classic Drawer) -->
    <LinearLayout
        android:id="@+id/leftSidebar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_osd_translucent"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Group List -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分组"
                android:textColor="@color/tv_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groupRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:background="#33FFFFFF" />

        <!-- Channel List -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="频道列表"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Right Catch-up / EPG Panel (7天回看时移) -->
    <LinearLayout
        android:id="@+id/rightEpgPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_osd_translucent"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/epgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7天时移回看"
            android:textColor="@color/tv_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/epgSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择历史节目即可跳转回看"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp"
            android:paddingBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epgRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- 5. Bottom OSD Banner -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:background="@drawable/bg_osd_translucent"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/osdLogo"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/osdChannelNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="01"
            android:textColor="@color/tv_accent"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/osdProgram"
            app:layout_constraintStart_toEndOf="@+id/osdLogo"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/osdChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="CCTV-1 综合"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/osdChannelNum"
            app:layout_constraintStart_toEndOf="@+id/osdChannelNum" />

        <TextView
            android:id="@+id/osdBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/selector_tv_item"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="4K HDR"
            android:textColor="@color/tv_accent"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/osdChannelName"
            app:layout_constraintStart_toEndOf="@+id/osdChannelName"
            app:layout_constraintTop_toTopOf="@+id/osdChannelName" />

        <TextView
            android:id="@+id/osdSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/selector_tv_item"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="线路 1/1"
            android:textColor="@color/tv_badge_catchup"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/osdChannelName"
            app:layout_constraintStart_toEndOf="@+id/osdBadge"
            app:layout_constraintTop_toTopOf="@+id/osdChannelName" />

        <TextView
            android:id="@+id/osdAspect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/selector_tv_item"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="📐 自适应"
            android:textColor="@color/tv_accent"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/osdChannelName"
            app:layout_constraintStart_toEndOf="@+id/osdSource"
            app:layout_constraintTop_toTopOf="@+id/osdChannelName" />

        <TextView
            android:id="@+id/osdAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/selector_tv_item"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="🔊 双声道"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/osdChannelName"
            app:layout_constraintStart_toEndOf="@+id/osdAspect"
            app:layout_constraintTop_toTopOf="@+id/osdChannelName" />

        <TextView
            android:id="@+id/osdProgram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="正在播出：新闻联播"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/osdResolution"
            app:layout_constraintStart_toStartOf="@+id/osdChannelNum"
            app:layout_constraintTop_toBottomOf="@+id/osdChannelNum" />

        <TextView
            android:id="@+id/osdResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[OK] 换台  [←] 分组  [→] 7天回看  [菜单] 扫码配源"
            android:textColor="@color/tv_text_dim"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 6. Web Config / QR Code Modal Dialog -->
    <androidx.cardview.widget.CardView
        android:id="@+id/webConfigDialog"
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        android:focusable="false"
        app:cardBackgroundColor="@color/tv_bg_translucent"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:focusable="false"
            android:descendantFocusability="afterDescendants">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Left Column: Settings Options (430dp) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚙️ TiviLite 偏好设置"
                        android:textColor="@color/tv_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Pro Status Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/selector_tv_button"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/settingProStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👑 TiviLite Pro 已永久激活"
                            android:textColor="@color/tv_badge_catchup"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnViewProDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            app:backgroundTint="@null"
                            android:background="@drawable/selector_tv_button"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@+id/btnToggleAspectRatio"
                            android:text="会员详情"
                            android:textColor="#FFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Aspect Ratio Toggle Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnToggleAspectRatio"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnViewProDetails"
                        android:nextFocusDown="@+id/btnToggleAudioTrack"
                        android:text="📐 画面比例: 自适应 (FIT) - 点击切换"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Audio Track Toggle Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnToggleAudioTrack"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnToggleAspectRatio"
                        android:nextFocusDown="@+id/btnToggleMiniDrawer"
                        android:text="🔊 音轨/声道: 标准立体声 - 点击切换"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Mini Drawer Preview Toggle Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnToggleMiniDrawer"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnToggleAudioTrack"
                        android:nextFocusDown="@+id/btnSwitchBestSource"
                        android:text="🎬 抽屉边看边选小窗微缩: 已开启 - 点击切换"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Best Source Benchmark Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSwitchBestSource"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnToggleMiniDrawer"
                        android:nextFocusDown="@+id/btnToggleDirection"
                        android:text="⚡ 自动测速并优选最佳线路"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Channel Up/Down Invert Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnToggleDirection"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnSwitchBestSource"
                        android:nextFocusDown="@+id/btnToggleAutoBoot"
                        android:text="🎮 遥控切台方向: 正常 (▲上一台 / ▼下一台)"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Auto Boot Start Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnToggleAutoBoot"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnToggleDirection"
                        android:nextFocusDown="@+id/btnToggleDecoder"
                        android:text="🚀 开机自动直达直播: 已开启 - 点击切换"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Decoder Mode Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnToggleDecoder"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnToggleAutoBoot"
                        android:nextFocusDown="@+id/btnLanSync"
                        android:text="🎬 解码器模式: 硬件加速 (推荐流畅) - 点击切换"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- LAN TV Sync Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLanSync"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnToggleDecoder"
                        android:nextFocusDown="@+id/btnCheckUpdate"
                        android:text="📡 局域网多电视同源联动 (克隆配置)"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Online OTA Update Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnLanSync"
                        android:nextFocusDown="@+id/btnCloseDialog"
                        android:text="🔄 在线检查新版本更新"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />

                    <!-- Close Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCloseDialog"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="6dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnCheckUpdate"
                        android:text="❌ 关闭窗口 (按遥控返回键亦可)"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Center Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:background="#22FFFFFF" />

                <!-- Right Column: Phone Assistant & QR Code (300dp) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 局域网配源与虚拟遥控"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="同一 Wi-Fi 手机浏览器/微信扫码"
                        android:textColor="@color/tv_text_dim"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                    <!-- QR Code Section -->
                    <ImageView
                        android:id="@+id/qrCodeImageView"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="6dp"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/webServerUrlText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#1A202E"
                        android:padding="6dp"
                        android:focusable="false"
                        android:text="http://192.168.1.100:8888"
                        android:textAlignment="center"
                        android:textColor="@color/tv_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Subscription Summary Badge -->
                    <TextView
                        android:id="@+id/subscriptionSummaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#15FFFFFF"
                        android:padding="5dp"
                        android:text="📁 订阅源: 暂无生效订阅 (扫码导入)"
                        android:textColor="@color/tv_badge_catchup"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="手机化身触控遥控器 · 换台/音量/源管理"
                        android:textColor="@color/tv_text_dim"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- 7. Catch-up Seek Bar OSD -->
    <LinearLayout
        android:id="@+id/catchupSeekBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="60dp"
        android:layout_marginBottom="90dp"
        android:orientation="vertical"
        android:background="@drawable/bg_osd_translucent"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏪ 7天时移回看中"
                android:textColor="@color/tv_badge_catchup"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/seekTimeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="00:15:30 / 00:45:00"
                android:textColor="@color/tv_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/catchupProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progress="35"
            android:progressTint="@color/tv_accent"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="[OK 确认] 立即返回实时直播  |  [← / →] 快退快进 15 秒  |  [返回键] 退出回看"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 8. Floating Channel Number Input Badge (0-9 Digits) -->
    <TextView
        android:id="@+id/channelNumberInputBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="36dp"
        android:background="@drawable/bg_osd_translucent"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="01"
        android:textColor="@color/tv_accent"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 9. Playback Error & Failover Overlay -->
    <androidx.cardview.widget.CardView
        android:id="@+id/playbackErrorOverlay"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="#E610121A"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="播放异常"
                android:textColor="#EF4444"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorDiagnostic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="连接源服务器超时 (网络抖动或源下线)"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/errorRetryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="正在自动重试中..."
                android:textColor="@color/tv_accent"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/errorActionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="[OK 确认] 立即重试  |  [◄ / ► 左右] 切换备用线路\n[▲ / ▼ 上下] 快速换台  |  [返回] 关闭提示"
                android:textColor="@color/tv_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 8. First Launch Onboarding Wizard (纯净播放器无源引导向导) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/onboardingOverlay"
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        app:cardBackgroundColor="#F011141E"
        app:cardCornerRadius="20dp"
        app:cardElevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Title & Pure Player Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📺 欢迎使用 TiviLite 纯净播放器"
                    android:textColor="@color/tv_accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2010B981"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🛡️ 零捆绑 · 纯净播放"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="本机当前暂无电视频道订阅。请使用手机或电脑将您的 M3U / TXT 源推送到大屏："
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <!-- QR Code & Setup Steps Split -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left: Big QR Code -->
                <LinearLayout
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/onboardingQrCode"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:background="#FFFFFF"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/onboardingServerUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="http://192.168.1.116:8888"
                        android:textColor="@color/tv_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Right: Step-by-step Guide -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1️⃣ 手机连接相同家庭 Wi-Fi，扫描左侧二维码"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="2️⃣ 在网页中粘贴您的 M3U 订阅或 TXT 频道列表"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="3️⃣ 点击「立即推送」，电视大屏将自动切入播放"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="#22FFFFFF" />

                    <!-- Quick Demo Stream Button for decoder testing -->
                    <Button
                        android:id="@+id/btnOnboardingDemo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:focusable="true"
                        android:backgroundTint="#242938"
                        android:text="✨ 载入合规演示流 (仅供解码与网络测试)"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 9. Remote Key Hint Floating Toast (新手遥控快捷键指引) -->
    <LinearLayout
        android:id="@+id/remoteHintToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_osd_translucent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 遥控操作: [◄ 左键] 频道列表  |  [► 右键] 7天回看  |  [长按OK] 收藏频道  |  [菜单键] 偏好设置"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
