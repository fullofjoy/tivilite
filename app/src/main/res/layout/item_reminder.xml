<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardBackgroundColor="@drawable/selector_tv_item"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_tv_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/reminderTime"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="19:35 待播"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reminderChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CCTV-5 体育"
                android:textColor="@color/tv_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/reminderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="2026欧冠半决赛 曼城 vs 皇家马德里"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancelReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#26FF4D4F"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="取消预约"
            android:textColor="#FF4D4F"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
