<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/tv_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3045" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tv_accent_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_unfocused" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
